<?xml version="1.0" encoding="utf-8"?>
<!-- Applies to Android 12+. Same policy as backup_rules.xml: keep user data
     (monitored apps, read progress, preferences), skip the re-downloadable
     translation databases. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="translations" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="translations" />
    </device-transfer>
</data-extraction-rules>