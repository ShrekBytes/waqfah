            android:strokeLineJoin="round"
            android:strokeWidth="4.21875" />
        <!-- Right page (mirrored) -->
        <path
            android:fillColor="#71835F"
            android:pathData="M57.7969,33.3281 C63.0703,28.8984 71.5078,26.7891 79.9453,27.6328 L79.9453,69.8203 C71.5078,68.9766 63.0703,71.0859 57.7969,75.5156 Z"
            android:strokeColor="#71835F"
            android:strokeLineJoin="round"
            android:strokeWidth="4.21875" />
    </group>
</vector>
