    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.8"
        android:scaleY="0.8">
        <!-- Left page (its straight inner edge doubles as half of the pause mark) -->
        <path
            android:fillColor="#71835F"
            android:pathData="M50.2031,33.3281 C44.9297,28.8984 36.4922,26.7891 28.0547,27.6328 L28.0547,69.8203 C36.4922,68.9766 44.9297,71.0859 50.2031,75.5156 Z"
