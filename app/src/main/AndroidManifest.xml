<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Normal runtime permission: only decides whether the foreground-service
         notification is visible on Android 13+. Detection never depends on it —
         a denial simply keeps that notification hidden (the pre-13 behavior).
         Requested as an optional row in the permissions flow, never gated on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Normal permission: lets BootReceiver restart the monitor service after
         reboot so detection survives a device restart without the user
         reopening Waqfah (no runtime prompt involved). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Exempts TriggerActivity launches from Android 10+ background activity
         start restrictions. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Some ROMs gate background activity starts behind their own
             permission, which lives in the vendor settings app rather than in
             Settings. Package visibility filtering hides that app from
             resolveActivity unless it is declared here, which would make the
             capability probe answer "no" on every device (ADR-0008). -->
        <package android:name="com.miui.securitycenter" />
    </queries>

    <application
        android:name=".WaqfahApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Waqfah">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Waqfah.Starting"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".TriggerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Waqfah.Trigger" />

        <service
            android:name=".detection.AppMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">

            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Checks which app moved to the foreground so the reading pause can appear before selected apps open" />

        </service>

        <receiver
            android:name=".detection.BootReceiver"
            android:enabled="true"
            android:exported="false">

            <!-- BOOT_COMPLETED is a protected system broadcast, so exported=false
                 still receives it while blocking spoofed intents from other apps
                 (the documented pattern for post-boot alarm/service restarts). -->
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Serves the share image to the system share sheet from the cache
             directory. exported=false + grantUriPermissions: the sheet's
             target receives a temporary read grant on the content URI; no
             storage permission is ever requested. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Persists per-app locales below Android 13 so
             AppCompatDelegate.setApplicationLocales survives restarts there. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

    </application>

</manifest>
